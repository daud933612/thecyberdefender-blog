---
import { getCollection } from 'astro:content';
import { Search, X, FileText, ArrowRight, CornerDownLeft } from 'lucide-astro';

const allPosts = await getCollection('blog');
const searchIndex = allPosts.map(post => ({
  title: post.data.title,
  description: post.data.description || '',
  tag: post.data.tag || 'Article',
  slug: `/articles/${post.slug}/`,
  date: new Date(post.data.pubDate).toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })
}));
---

<!-- Modal Backdrop & Container -->
<div 
  id="searchModal" 
  class="fixed inset-0 z-[100] hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-slate-950/80 backdrop-blur-md transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
>
  <div 
    id="searchCard" 
    class="relative w-full max-w-2xl rounded-2xl bg-[#060E1D] border border-cyan-500/30 shadow-[0_0_50px_rgba(0,229,255,0.2)] overflow-hidden flex flex-col max-h-[80vh] animate-in fade-in zoom-in-95 duration-150"
  >
    <!-- Search Input Bar -->
    <div class="flex items-center gap-3 px-4 py-3.5 border-b border-cyan-500/20 bg-[#030814]">
      <Search class="w-5 h-5 text-[#00E5FF] shrink-0" />
      <input 
        id="modalSearchInput" 
        type="text" 
        placeholder="Search security articles, guides, CVEs..." 
        autocomplete="off"
        class="w-full bg-transparent text-sm text-white placeholder:text-slate-500 font-mono focus:outline-none"
      />
      <kbd class="hidden sm:inline-block text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
        ESC
      </kbd>
      <button 
        id="closeSearchBtn" 
        aria-label="Close search" 
        class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- Results List -->
    <div id="searchResultsList" class="p-3 overflow-y-auto divide-y divide-slate-800/60 space-y-1">
      <div id="searchPlaceholder" class="py-10 text-center text-xs font-mono text-slate-500">
        Type a query to search across all cybersecurity briefings...
      </div>
    </div>

    <!-- Modal Footer Controls -->
    <div class="px-4 py-2.5 border-t border-cyan-500/15 bg-[#030712] text-[11px] font-mono text-slate-400 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <CornerDownLeft class="w-3 h-3 text-cyan-400" /> to select
        </span>
        <span>&bull;</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px]">ESC</kbd> to exit</span>
      </div>
      <span class="text-[#00E5FF] font-bold">TheCyberDefender Index</span>
    </div>
  </div>
</div>

<!-- Embedded Search Data -->
<script define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<script>
  const searchModal = document.getElementById('searchModal');
  const searchInput = document.getElementById('modalSearchInput') as HTMLInputElement;
  const resultsList = document.getElementById('searchResultsList');
  const closeBtn = document.getElementById('closeSearchBtn');
  const searchCard = document.getElementById('searchCard');

  const openSearch = () => {
    if (!searchModal || !searchInput) return;
    searchModal.classList.remove('hidden');
    searchModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    setTimeout(() => searchInput.focus(), 50);
  };

  const closeSearch = () => {
    if (!searchModal || !searchInput) return;
    searchModal.classList.add('hidden');
    searchModal.classList.remove('flex');
    document.body.style.overflow = '';
    searchInput.value = '';
    renderResults([]);
  };

  // Bind Ctrl+K / Cmd+K and ESC
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  // Global triggers
  document.querySelectorAll('[data-open-search]').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      openSearch();
    });
  });

  closeBtn?.addEventListener('click', closeSearch);
  searchModal?.addEventListener('click', (e) => {
    if (!searchCard?.contains(e.target as Node)) {
      closeSearch();
    }
  });

  // Real-time filtering
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    const index = (window as any).__SEARCH_INDEX__ || [];

    if (!q) {
      if (resultsList) {
        resultsList.innerHTML = `
          <div class="py-10 text-center text-xs font-mono text-slate-500">
            Type a query to search across all cybersecurity briefings...
          </div>
        `;
      }
      return;
    }

    const filtered = index.filter((item: any) => 
      item.title.toLowerCase().includes(q) ||
      item.description.toLowerCase().includes(q) ||
      item.tag.toLowerCase().includes(q)
    );

    renderResults(filtered, q);
  });

  function renderResults(items: any[], query = '') {
    if (!resultsList) return;

    if (items.length === 0 && query) {
      resultsList.innerHTML = `
        <div class="py-10 text-center text-xs font-mono text-slate-500">
          No briefings found matching <span class="text-cyan-400">"${query}"</span>
        </div>
      `;
      return;
    }

    resultsList.innerHTML = items.map(item => `
      <a 
        href="${item.slug}" 
        class="group flex items-start justify-between gap-4 p-3 rounded-xl hover:bg-[#091528] border border-transparent hover:border-cyan-500/30 transition-all"
      >
        <div class="flex items-start gap-3">
          <div class="p-2 rounded-lg bg-cyan-500/10 text-cyan-400 mt-0.5 shrink-0 border border-cyan-500/20 group-hover:border-cyan-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white group-hover:text-[#00E5FF] transition-colors">${item.title}</span>
              <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-cyan-500/15 text-cyan-300 uppercase">${item.tag}</span>
            </div>
            ${item.description ? `<p class="text-[11px] text-slate-400 mt-1 line-clamp-1">${item.description}</p>` : ''}
          </div>
        </div>
        <span class="text-[10px] font-mono text-slate-500 shrink-0 mt-1">${item.date}</span>
      </a>
    `).join('');
  }
</script>