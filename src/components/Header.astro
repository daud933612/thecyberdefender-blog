---
import { Shield, Search } from 'lucide-astro';

// Normalize current path (remove trailing slash for consistent matching)
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/articles' },
  { name: 'Tools', href: '/tools' },
  { name: 'Guides', href: '/guides' },
  { name: 'Write for Us', href: '/write-for-us' },
];
---

<header class="w-full bg-[#030712]/95 backdrop-blur-md border-b border-cyan-500/10 sticky top-0 z-50">
  <div class="max-w-[1400px] mx-auto px-6 h-20 flex items-center justify-between gap-6">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center shadow-[0_0_15px_rgba(0,229,255,0.3)]">
        <Shield class="w-5 h-5 text-cyan-400 fill-cyan-400/20" />
      </div>
      <div>
        <span class="text-lg font-bold text-white tracking-wide block leading-tight">TheCyberDefender</span>
        <span class="text-[9px] font-mono tracking-[0.25em] text-cyan-400 uppercase font-semibold">LEARN &bull; EXPLORE &bull; STAY SECURE</span>
      </div>
    </a>

    <!-- Nav Items with Dynamic Active Detection -->
    <nav class="hidden md:flex items-center gap-7 text-[13px] font-medium">
      {navLinks.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isActive = itemPath === '/' 
          ? currentPath === '/' 
          : currentPath === itemPath || currentPath.startsWith(itemPath + '/');

        return (
          <a 
            href={item.href} 
            class={`relative py-1 transition-colors whitespace-nowrap ${
              isActive 
                ? 'text-[#00E5FF] font-semibold' 
                : 'text-slate-300 hover:text-[#00E5FF]'
            }`}
          >
            {item.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-[#00E5FF] shadow-[0_0_8px_#00E5FF] rounded-full"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Actions Cluster (Only Search & Subscribe) -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Quick Command Search Bar Pill Trigger (Opens Modal on click or Ctrl+K) -->
      <button 
        type="button"
        data-open-search
        aria-label="Search articles"
        class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#071120] border border-cyan-500/20 hover:border-cyan-400/60 text-slate-400 hover:text-slate-200 text-xs font-mono transition-all shadow-inner group"
      >
        <Search class="w-3.5 h-3.5 text-cyan-400 group-hover:scale-110 transition-transform" />
        <span class="hidden sm:inline text-[11px] text-slate-400">Search</span>
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded bg-slate-900 border border-slate-700/60 text-[10px] text-cyan-400 font-mono">
          Ctrl K
        </kbd>
      </button>

      <a 
        href="/subscribe" 
        class="px-4 py-2 rounded-xl bg-[#00D2EE] hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-[0_0_20px_rgba(0,210,238,0.45)] transition-all"
      >
        Subscribe
      </a>
    </div>
  </div>
</header>