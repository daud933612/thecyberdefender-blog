---
import { Shield, Search } from 'lucide-astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/articles' },
  { name: 'Tools', href: '/tools' },
  { name: 'Guides', href: '/guides' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
  { name: 'Write for Us', href: '/write-for-us' },
];
---

<header class="sticky top-0 z-50 bg-[#050B14]/90 backdrop-blur-md border-b border-cyan-500/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="p-2 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 group-hover:shadow-[0_0_15px_rgba(0,229,255,0.4)] transition-all">
        <Shield class="w-5 h-5" />
      </div>
      <div>
        <span class="font-bold text-slate-100 tracking-wide block leading-none text-base">TheCyberDefender</span>
        <span class="text-[9px] font-mono text-cyan-400 tracking-widest uppercase">Learn | Explore | Stay Secure</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-300">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`transition-colors hover:text-cyan-400 ${
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) 
              ? 'text-cyan-400 font-semibold border-b border-cyan-400 pb-0.5' 
              : 'text-slate-300'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a href="/articles" class="p-2 text-slate-400 hover:text-cyan-400 transition-colors" aria-label="Search articles">
        <Search class="w-4 h-4" />
      </a>
      <a href="/subscribe" class="px-4 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-white text-xs font-semibold shadow-md shadow-sky-500/20 transition-all">
        Subscribe
      </a>
    </div>
  </div>
</header>