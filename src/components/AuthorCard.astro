---
import { ShieldCheck, Twitter, Github, Linkedin } from 'lucide-astro';

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  avatar?: string;
  twitter?: string;
  github?: string;
  linkedin?: string;
}

const {
  name = "Daud Ahmed",
  role = "Lead Security Researcher & Platform Founder",
  bio = "Cybersecurity engineer focused on threat intelligence, secure architectures, and defensive operations. Dedicated to breaking down complex security concepts for defenders worldwide.",
  avatar = "",
  twitter = "https://twitter.com",
  github = "https://github.com",
  linkedin = "https://linkedin.com"
} = Astro.props;
---

<div class="mt-14 pt-8 border-t border-cyan-500/20">
  <div class="rounded-2xl bg-[#070E1B] border border-cyan-500/30 p-6 sm:p-7 shadow-[0_0_25px_rgba(0,229,255,0.08)] flex flex-col sm:flex-row items-start sm:items-center gap-5">
    <!-- Author Avatar / Hologram Icon -->
    <div class="relative shrink-0">
      <div class="w-16 h-16 rounded-2xl bg-[#030914] border-2 border-cyan-400 flex items-center justify-center shadow-[0_0_15px_rgba(0,229,255,0.3)] overflow-hidden">
        {avatar ? (
          <img src={avatar} alt={name} class="w-full h-full object-cover" />
        ) : (
          <ShieldCheck class="w-8 h-8 text-[#00E5FF]" />
        )}
      </div>
      <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-[#070E1B]" title="Verified Researcher"></span>
    </div>

    <!-- Info & Bio -->
    <div class="flex-1">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-white">{name}</span>
            <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 uppercase">AUTHOR</span>
          </div>
          <p class="text-xs font-mono text-cyan-400 mt-0.5">{role}</p>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-2.5 text-slate-400">
          <a href={twitter} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors p-1" aria-label="Twitter">
            <Twitter class="w-3.5 h-3.5" />
          </a>
          <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors p-1" aria-label="GitHub">
            <Github class="w-3.5 h-3.5" />
          </a>
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors p-1" aria-label="LinkedIn">
            <Linkedin class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <p class="text-xs text-slate-400 mt-2.5 leading-relaxed">
        {bio}
      </p>
    </div>
  </div>
</div>