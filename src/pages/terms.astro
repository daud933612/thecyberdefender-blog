---
import Layout from '../layouts/Layout.astro';
import { AlertTriangle, ShieldAlert, Terminal, Scale } from 'lucide-astro';

const lastUpdated = "September 14, 2026";
---

<Layout title="Terms of Service | TheCyberDefender" description="Usage terms and security research disclaimers for TheCyberDefender.live">
  <div class="max-w-4xl mx-auto px-6 py-14">
    <!-- Page Badge & Heading -->
    <div class="mb-10 pb-6 border-b border-cyan-500/15">
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono tracking-widest text-[#00E5FF] font-bold uppercase mb-3 px-2.5 py-1 rounded bg-cyan-500/10 border border-cyan-500/30">
        <Scale class="w-3 h-3" />
        TERMS & CONDITIONS
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Terms of Service</h1>
      <p class="text-xs font-mono text-slate-400 mt-2">Last Updated: {lastUpdated}</p>
    </div>

    <div class="space-y-8 text-sm leading-relaxed text-slate-300">
      <section class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6">
        <h2 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <Terminal class="w-4 h-4 text-cyan-400" />
          1. Acceptance of Terms
        </h2>
        <p>
          By accessing and utilizing TheCyberDefender (thecyberdefender.live), you acknowledge and agree to comply with these terms. If you disagree with any segment of these provisions, you must discontinue platform use immediately.
        </p>
      </section>

      <section class="rounded-2xl bg-[#070E1B] border border-amber-500/30 p-6">
        <h2 class="text-base font-bold text-amber-400 mb-2 flex items-center gap-2">
          <AlertTriangle class="w-4 h-4 text-amber-400" />
          2. Educational Purpose & Authorized Testing Disclaimer
        </h2>
        <p>
          All technical guides, network reconnaissance walk-throughs, and software demonstrations provided on this platform are designed <strong>strictly for educational, defensive, and authorized audit environments</strong>. The misuse of information, code, or tools to execute malicious operations, unauthorized intrusion, or denial of service against networks without explicit written permission is illegal and strictly prohibited. TheCyberDefender disclaims any liability for damages resulting from user misuse.
        </p>
      </section>

      <section class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6">
        <h2 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <ShieldAlert class="w-4 h-4 text-cyan-400" />
          3. Intellectual Property
        </h2>
        <p>
          Unless credited to open-source licenses or specific contributing authors, all articles, graphic assets, and architectural content created for TheCyberDefender remain protected intellectual property. Unauthorized verbatim scraping or commercial mirroring without attribution is disallowed.
        </p>
      </section>

      <section class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6">
        <h2 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <Scale class="w-4 h-4 text-cyan-400" />
          4. Modifications
        </h2>
        <p>
          We reserve the prerogative to revise these Terms of Service at our discretion. Continuous usage of the website constitutes acceptance of the modified conditions.
        </p>
      </section>
    </div>
  </div>
</Layout>