---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Shield, Calendar, Clock, Lock, BellRing } from 'lucide-astro';

// Pull real markdown posts dynamically from src/content/blog/
const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const categories = [
  "All Articles",
  "Cybersecurity Basics",
  "Threats & Attacks",
  "Tools & Software",
  "Guides",
  "Networking",
  "Programming",
  "Digital Privacy"
];
---

<Layout title="All Articles | Cybersecurity News & Guides">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_#00E5FF]"></span>
        <span class="text-[11px] font-mono tracking-widest text-[#00E5FF] uppercase font-bold">PUBLIC INTELLIGENCE FEED</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">All Articles</h1>
      <p class="text-sm text-slate-400 mt-1">
        Explore actionable threat intelligence, tutorials, and practical defensive blueprints.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Categories Sidebar -->
      <aside class="lg:col-span-3 bg-[#070E1B] border border-cyan-500/20 rounded-2xl p-4 sticky top-24">
        <h2 class="text-xs font-mono font-bold tracking-wider text-cyan-400 uppercase mb-3 px-2">
          Categories
        </h2>
        <nav class="space-y-1">
          {categories.map((cat, idx) => (
            <button 
              class={`w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-medium transition-all ${
                idx === 0 
                  ? 'bg-cyan-500/15 border border-cyan-500/40 text-cyan-300 font-semibold shadow-[0_0_15px_rgba(0,229,255,0.15)]' 
                  : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200'
              }`}
            >
              {cat}
            </button>
          ))}
        </nav>
      </aside>

      <!-- Articles Grid Area -->
      <div class="lg:col-span-9">
        {allPosts.length === 0 ? (
          <div class="relative overflow-hidden rounded-2xl bg-[#060E1D] border border-cyan-500/20 p-8 sm:p-12 text-center shadow-[0_0_35px_rgba(0,229,255,0.06)]">
            <div class="absolute -right-12 -top-12 w-44 h-44 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>
            
            <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center mx-auto mb-5 text-[#00E5FF] shadow-[0_0_20px_rgba(0,229,255,0.2)]">
              <Lock class="w-6 h-6" />
            </div>

            <span class="inline-block text-[10px] font-mono tracking-widest text-[#00E5FF] uppercase font-bold px-3 py-1 rounded bg-cyan-500/10 border border-cyan-500/20 mb-3">
              INTELLIGENCE PIPELINE ACTIVE
            </span>

            <h3 class="text-xl font-extrabold text-white mb-2">New Security Briefings Underway</h3>
            <p class="text-xs text-slate-400 mb-6 max-w-md mx-auto leading-relaxed">
              Our research team is compiling scheduled teardowns covering modern intrusion vectors, packet diagnostics, and defense configurations. Subscribe to our threat dispatch to receive updates.
            </p>

            <a 
              href="/subscribe" 
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#00D2EE] hover:bg-cyan-300 text-slate-950 font-bold text-xs shadow-[0_0_20px_rgba(0,210,238,0.4)] transition-all"
            >
              <BellRing class="w-3.5 h-3.5" />
              <span>Get Dispatch Notifications</span>
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {allPosts.map((post, idx) => (
              <a 
                href={`/articles/${post.slug}/`} 
                class="group rounded-2xl bg-[#070E1B] border border-cyan-500/20 hover:border-cyan-400/80 p-4 shadow-lg transition-all duration-300 hover:shadow-[0_0_25px_rgba(0,229,255,0.15)] flex flex-col justify-between"
              >
                <div>
                  <div class="relative h-40 rounded-xl bg-[#030814] border border-cyan-500/25 overflow-hidden flex items-center justify-center mb-4">
                    {post.data.heroImage ? (
                      <img 
                        src={post.data.heroImage} 
                        alt={post.data.title} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : idx % 3 === 0 ? (
                      <div class="relative w-full h-full flex items-center justify-center">
                        <div class="absolute inset-0 bg-[radial-gradient(#00e5ff_1px,transparent_1px)] [background-size:14px_14px] opacity-25"></div>
                        <svg class="w-20 h-20 text-cyan-400 drop-shadow-[0_0_15px_rgba(0,229,255,0.7)]" viewBox="0 0 100 100" fill="none">
                          <circle cx="50" cy="50" r="38" stroke="#00E5FF" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>
                          <circle cx="50" cy="50" r="28" stroke="#00E5FF" stroke-width="1.8"/>
                          <rect x="42" y="48" width="16" height="14" rx="2.5" fill="#00E5FF"/>
                          <path d="M45 48 V42 C45 39.2 47.2 37 50 37 C52.8 37 55 39.2 55 42 V48" stroke="#00E5FF" stroke-width="2.5" fill="none"/>
                        </svg>
                      </div>
                    ) : idx % 3 === 1 ? (
                      <div class="relative w-full h-full flex items-center justify-center">
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-950/40 to-blue-900/20"></div>
                        <svg class="w-20 h-20 text-cyan-400 drop-shadow-[0_0_15px_rgba(0,229,255,0.7)]" viewBox="0 0 100 100" fill="none">
                          <polygon points="50,18 76,32 76,64 50,82 24,64 24,32" stroke="#00E5FF" stroke-width="1.8" fill="#040C1A"/>
                          <circle cx="50" cy="50" r="4.5" fill="#00E5FF"/>
                        </svg>
                      </div>
                    ) : (
                      <div class="relative w-full h-full flex items-center justify-center">
                        <Shield class="w-12 h-12 text-cyan-400/80 group-hover:text-cyan-300 drop-shadow-[0_0_15px_rgba(0,229,255,0.6)] group-hover:scale-110 transition-transform" />
                      </div>
                    )}

                    <span class="absolute top-2.5 left-2.5 text-[9px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 uppercase font-semibold">
                      {post.data.tag || 'RESEARCH'}
                    </span>
                  </div>

                  <h3 class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">
                    {post.data.title}
                  </h3>
                </div>

                <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
                  <span class="flex items-center gap-1.5">
                    <Calendar class="w-3.5 h-3.5 text-cyan-400" />
                    {new Date(post.data.pubDate).toLocaleDateString('en-us', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </span>
                  <span class="flex items-center gap-1.5">
                    <Clock class="w-3.5 h-3.5 text-cyan-400" />
                    5 min read
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>