---
import Layout from '../layouts/Layout.astro';
import { Mail, MapPin, Send, Twitter, Youtube, Github } from 'lucide-astro';
---

<Layout title="Contact Us | Get In Touch">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 rounded-full">
          Get In Touch
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Contact Us
        </h1>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          Have a question, suggestion, or collaboration idea? We'd love to hear from you.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-center gap-3 p-3 rounded-xl bg-[#0B1528] border border-cyan-500/20">
            <div class="p-2 rounded-lg bg-cyan-500/10 text-cyan-400">
              <Mail class="w-4 h-4" />
            </div>
            <div>
              <div class="text-[10px] font-mono text-slate-400">Email</div>
              <a href="mailto:hello@thecyberdefender.com" class="text-xs font-semibold text-white hover:text-cyan-400 transition-colors">
                hello@thecyberdefender.com
              </a>
            </div>
          </div>

          <div class="flex items-center gap-3 p-3 rounded-xl bg-[#0B1528] border border-cyan-500/20">
            <div class="p-2 rounded-lg bg-cyan-500/10 text-cyan-400">
              <MapPin class="w-4 h-4" />
            </div>
            <div>
              <div class="text-[10px] font-mono text-slate-400">Location</div>
              <div class="text-xs font-semibold text-white">Islamabad, Pakistan</div>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <div class="text-[10px] font-mono text-slate-400 mb-2">Follow Us</div>
          <div class="flex items-center gap-3">
            <a href="#" class="p-2.5 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition-all">
              <Twitter class="w-4 h-4" />
            </a>
            <a href="#" class="p-2.5 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition-all">
              <Youtube class="w-4 h-4" />
            </a>
            <a href="#" class="p-2.5 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition-all">
              <Github class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-[#0B1528] border border-cyan-500/30 shadow-[0_0_30px_rgba(0,229,255,0.08)]">
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Message sent successfully!');">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Name</label>
            <input 
              type="text" 
              required 
              placeholder="Your name" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#060D1A] border border-cyan-500/20 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Email</label>
            <input 
              type="email" 
              required 
              placeholder="you@example.com" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#060D1A] border border-cyan-500/20 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Subject</label>
            <input 
              type="text" 
              required 
              placeholder="Select a subject" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#060D1A] border border-cyan-500/20 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Message</label>
            <textarea 
              rows="4" 
              required 
              placeholder="Your message..." 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#060D1A] border border-cyan-500/20 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition-colors resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-white text-xs font-bold shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2"
          >
            <Send class="w-3.5 h-3.5" />
            <span>Send Message</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>