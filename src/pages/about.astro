---
import Layout from '../layouts/Layout.astro';
import { BookOpen, Compass, ShieldCheck, Globe } from 'lucide-astro';
---

<Layout title="About Us | Who We Are">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 rounded-full">
          About Us
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Who We Are
        </h1>
        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed">
          TheCyberDefender is a modern cybersecurity platform built for learners, professionals, and enthusiasts. Our mission is to make cybersecurity knowledge accessible, practical, and easy to understand for everyone.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
          <div class="p-4 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-center">
            <div class="w-8 h-8 mx-auto rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2">
              <BookOpen class="w-4 h-4" />
            </div>
            <h3 class="text-xs font-bold text-white">Learn</h3>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Step-by-step tutorials and in-depth guides.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-center">
            <div class="w-8 h-8 mx-auto rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2">
              <Compass class="w-4 h-4" />
            </div>
            <h3 class="text-xs font-bold text-white">Explore</h3>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Latest tools, trends, and real-world insights.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#0B1528] border border-cyan-500/20 text-center">
            <div class="w-8 h-8 mx-auto rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <h3 class="text-xs font-bold text-white">Stay Secure</h3>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Practical tips to protect your digital life.</p>
          </div>
        </div>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="relative w-72 h-72 sm:w-88 sm:h-88 flex items-center justify-center">
          <div class="absolute inset-0 rounded-full bg-sky-500/15 blur-3xl"></div>
          <div class="absolute inset-6 rounded-full border border-cyan-500/30 animate-pulse"></div>
          
          <div class="relative p-10 rounded-full bg-[#081224]/90 border-2 border-cyan-400/70 shadow-[0_0_40px_rgba(0,229,255,0.25)] flex flex-col items-center justify-center">
            <Globe class="w-24 h-24 text-cyan-400" />
            <ShieldCheck class="w-8 h-8 text-sky-400 -mt-4 drop-shadow-[0_0_10px_rgba(0,229,255,0.8)]" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>