---
import Layout from '../layouts/Layout.astro';
import { 
  Layers, 
  KeyRound, 
  Network, 
  Globe, 
  Lock, 
  Search, 
  Bug, 
  FileSearch,
  ArrowRight
} from 'lucide-astro';

const categories = [
  { name: "All Tools", icon: Layers, active: true },
  { name: "Password Security", icon: KeyRound, active: false },
  { name: "Network Security", icon: Network, active: false },
  { name: "Web Security", icon: Globe, active: false },
  { name: "Encryption", icon: Lock, active: false },
  { name: "OSINT", icon: Search, active: false },
  { name: "Malware Analysis", icon: Bug, active: false },
  { name: "Forensics", icon: FileSearch, active: false },
];

const tools = [
  {
    name: "Nmap",
    description: "Network scanning & reconnaissance",
    link: "https://nmap.org",
    id: "nmap"
  },
  {
    name: "Wireshark",
    description: "Network protocol analyzer",
    link: "https://www.wireshark.org",
    id: "wireshark"
  },
  {
    name: "Metasploit",
    description: "Penetration testing framework",
    link: "https://www.metasploit.com",
    id: "metasploit"
  },
  {
    name: "Burp Suite",
    description: "Web application security",
    link: "https://portswigger.net/burp",
    id: "burp"
  },
  {
    name: "Hashcat",
    description: "Password recovery",
    link: "https://hashcat.net",
    id: "hashcat"
  },
  {
    name: "VirusTotal",
    description: "File & URL analysis",
    link: "https://www.virustotal.com",
    id: "virustotal"
  }
];
---

<Layout title="Cybersecurity Tools | Handpicked Security Software">
  <div class="max-w-[1400px] mx-auto px-6 py-12">
    <!-- Page Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Cybersecurity Tools
      </h1>
      <p class="text-sm text-slate-400 mt-2">
        Handpicked tools to help you scan, protect, and stay secure.
      </p>
    </div>

    <!-- Layout Grid: Sidebar + Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Category Sidebar -->
      <aside class="lg:col-span-3 rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-3 space-y-1.5">
        {categories.map((cat) => {
          const IconComponent = cat.icon;
          return (
            <button
              class={`w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-xs font-semibold transition-all ${
                cat.active
                  ? "bg-[#0070F3] text-white shadow-[0_0_15px_rgba(0,112,243,0.5)]"
                  : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/40"
              }`}
            >
              <IconComponent class="w-4 h-4 stroke-[2]" />
              <span>{cat.name}</span>
            </button>
          );
        })}
      </aside>

      <!-- Right 3x2 Tools Grid -->
      <div class="lg:col-span-9 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <div class="group rounded-2xl bg-[#070E1B] border border-cyan-500/25 hover:border-cyan-400/80 p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-[0_0_25px_rgba(0,229,255,0.15)] min-h-[220px]">
            <div>
              <!-- Tool Logo Tile -->
              <div class="w-14 h-14 rounded-2xl bg-[#040914] border border-cyan-500/40 flex items-center justify-center p-2.5 mb-5 shadow-[0_0_15px_rgba(0,229,255,0.1)] group-hover:border-cyan-400 group-hover:shadow-[0_0_20px_rgba(0,229,255,0.25)] transition-all">
                {tool.id === 'nmap' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" fill="#00E5FF" fill-opacity="0.3" />
                  </svg>
                )}

                {tool.id === 'wireshark' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20c4-1 9-5 11-13 2 4 4 9 5 13H4Z" fill="#00E5FF" fill-opacity="0.2"/>
                  </svg>
                )}

                {tool.id === 'metasploit' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 4h4.5l3.5 7 3.5-7H20v16h-4V10.5L12.5 17h-1L8 10.5V20H4V4Z"/>
                  </svg>
                )}

                {tool.id === 'burp' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l8 4.5v11L12 22l-8-4.5v-11L12 2z"/>
                    <path d="M13 6l-4 6h5l-2 6" stroke="#00E5FF" stroke-width="2"/>
                  </svg>
                )}

                {tool.id === 'hashcat' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M9 10h.01M15 10h.01"/>
                    <path d="M9.5 15a3.5 3.5 0 0 0 5 0"/>
                  </svg>
                )}

                {tool.id === 'virustotal' && (
                  <svg class="w-8 h-8 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16l-8 8 8 8H4"/>
                  </svg>
                )}
              </div>

              <!-- Title & Description -->
              <h3 class="text-base font-bold text-white group-hover:text-cyan-400 transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
                {tool.description}
              </p>
            </div>

            <!-- Action Link -->
            <div class="mt-6">
              <a 
                href={tool.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-400 hover:text-cyan-300 transition-colors"
              >
                <span>View Tool</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>