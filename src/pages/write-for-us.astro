---
import Layout from '../layouts/Layout.astro';
import { CheckCircle2, ArrowRight, FileCheck } from 'lucide-astro';
---

<Layout title="Write for Us | Contribute to TheCyberDefender">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 rounded-full">
          Write for Us
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Contribute to TheCyberDefender
        </h1>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">
          Are you passionate about cybersecurity? Share your knowledge, experience, or insights with our growing community. We welcome guest posts from writers, experts, and enthusiasts.
        </p>

        <h2 class="text-sm font-mono font-bold text-white uppercase tracking-wider mt-8 mb-4">
          Why Write for Us?
        </h2>
        <ul class="space-y-3">
          <li class="flex items-center gap-2.5 text-xs text-slate-300">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 shrink-0" />
            <span>Reach a global cybersecurity audience</span>
          </li>
          <li class="flex items-center gap-2.5 text-xs text-slate-300">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 shrink-0" />
            <span>Build your personal brand and authority</span>
          </li>
          <li class="flex items-center gap-2.5 text-xs text-slate-300">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 shrink-0" />
            <span>Get a do-follow backlink to your website or profile</span>
          </li>
          <li class="flex items-center gap-2.5 text-xs text-slate-300">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 shrink-0" />
            <span>Be part of a trusted security knowledge network</span>
          </li>
        </ul>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-[#0B1528] border border-cyan-500/30 shadow-[0_0_30px_rgba(0,229,255,0.08)]">
        <div class="flex items-center gap-2 mb-4">
          <FileCheck class="w-5 h-5 text-cyan-400" />
          <h2 class="text-base font-bold text-white">Submission Guidelines</h2>
        </div>

        <ul class="space-y-3 text-xs text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 font-bold">&bull;</span>
            <span><strong>Original Content:</strong> Well-researched, technical, and unpublished elsewhere.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 font-bold">&bull;</span>
            <span><strong>Length:</strong> Minimum 800 words with proper formatting and headings.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 font-bold">&bull;</span>
            <span><strong>Plagiarism:</strong> Zero tolerance policy (100% unique human-written content).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 font-bold">&bull;</span>
            <span><strong>Visuals:</strong> Use relevant diagrams, CLI snippets, or screenshots if any.</span>
          </li>
        </ul>

        <div class="mt-8 pt-6 border-t border-slate-800">
          <a 
            href="mailto:hello@thecyberdefender.com?subject=Guest%20Post%20Submission" 
            class="w-full py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-white text-xs font-bold shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2"
          >
            <span>Submit Your Article</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>