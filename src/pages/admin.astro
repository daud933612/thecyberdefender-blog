---
import Layout from '../layouts/Layout.astro';
import { 
  Sparkles, 
  AlertCircle, 
  Send, 
  Search, 
  Settings,
  ExternalLink
} from 'lucide-astro';
---

<Layout title="Article Studio & Live Publishing | TheCyberDefender">
  <div class="max-w-[1500px] mx-auto px-4 sm:px-6 py-8">
    
    <!-- Top Action Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-cyan-500/20">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[10px] font-mono tracking-widest text-[#00E5FF] uppercase font-bold">Studio Hub</span>
        </div>
        <h1 class="text-2xl font-black text-white mt-1">Direct Article Publisher</h1>
      </div>

      <div class="flex items-center gap-3">
        <button 
          id="configToggleBtn" 
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#091528] border border-cyan-500/40 text-slate-200 text-xs font-bold hover:bg-cyan-500/10 hover:border-cyan-400 transition-all"
        >
          <Settings class="w-4 h-4 text-cyan-400" />
          <span>Sync Settings</span>
        </button>

        <button 
          id="publishBtn" 
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#00D2EE] hover:bg-cyan-300 text-slate-950 text-xs font-black shadow-[0_0_25px_rgba(0,210,238,0.5)] transition-all cursor-pointer"
        >
          <Send class="w-4 h-4 stroke-[2.5]" />
          <span id="publishBtnText">Publish Post Live</span>
        </button>
      </div>
    </div>

    <!-- Optional Production GitHub Settings Drawer -->
    <div id="configDrawer" class="hidden mb-8 rounded-2xl bg-[#070E1B] border border-cyan-500/30 p-6 space-y-4 text-xs font-mono">
      <div class="flex items-center justify-between border-b border-cyan-500/10 pb-3">
        <span class="text-white font-bold">Production Repository Commit Credentials (Optional for Local Dev)</span>
        <span class="text-slate-400 text-[11px]">Saved locally in your browser storage</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-slate-400 uppercase text-[10px] mb-1">GitHub Personal Access Token</label>
          <input id="ghToken" type="password" placeholder="ghp_xxxxxxxxxxxx" class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-slate-200 focus:outline-none focus:border-[#00E5FF]" />
        </div>
        <div>
          <label class="block text-slate-400 uppercase text-[10px] mb-1">GitHub Repository Owner</label>
          <input id="ghOwner" type="text" placeholder="e.g. your-github-username" class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-slate-200 focus:outline-none focus:border-[#00E5FF]" />
        </div>
        <div>
          <label class="block text-slate-400 uppercase text-[10px] mb-1">Repository Name</label>
          <input id="ghRepo" type="text" placeholder="e.g. thecyberdefender" class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-slate-200 focus:outline-none focus:border-[#00E5FF]" />
        </div>
      </div>
    </div>

    <!-- Main Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left: WordPress Gutenberg-Style Form & Content (8 Cols) -->
      <div class="lg:col-span-8 space-y-6">
        
        <div class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6 space-y-4 shadow-xl">
          <div>
            <label class="block text-[11px] font-mono text-cyan-400 uppercase font-semibold mb-2">Post Title (H1)</label>
            <input 
              id="postTitle" 
              type="text" 
              placeholder="e.g. How to Prevent Phishing Attacks (Real Examples + Tips)" 
              class="w-full px-4 py-3 rounded-xl bg-[#030712] border border-cyan-500/30 text-white font-bold text-lg focus:outline-none focus:border-[#00E5FF] transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase mb-1">Permalink / Slug</label>
              <input 
                id="postSlug" 
                type="text" 
                placeholder="how-to-prevent-phishing-attacks" 
                class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-xs text-slate-200 font-mono focus:outline-none focus:border-[#00E5FF]"
              />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase mb-1">Category Tag</label>
              <input 
                id="postTag" 
                type="text" 
                value="Cybersecurity" 
                class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-xs text-slate-200 focus:outline-none focus:border-[#00E5FF]"
              />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-slate-400 uppercase mb-1">Publish Date</label>
              <input 
                id="postDate" 
                type="text" 
                value={new Date().toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' })}
                class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-xs text-slate-200 font-mono focus:outline-none focus:border-[#00E5FF]"
              />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-mono text-slate-400 uppercase mb-1">Meta Description (Snippet)</label>
            <textarea 
              id="postDesc" 
              rows="2" 
              placeholder="Provide a high-converting 140-160 character overview of the security briefing..." 
              class="w-full px-3 py-2 rounded-lg bg-[#030712] border border-cyan-500/20 text-xs text-slate-200 focus:outline-none focus:border-[#00E5FF]"
            ></textarea>
          </div>
        </div>

        <!-- Markdown Body -->
        <div class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6 shadow-xl space-y-3">
          <div class="flex items-center justify-between border-b border-cyan-500/10 pb-3">
            <span class="text-xs font-mono text-slate-300 font-bold">Article Body Content (Markdown Supported)</span>
            <span id="wordCountLive" class="text-xs font-mono text-[#00E5FF]">0 words</span>
          </div>

          <textarea 
            id="postContent" 
            rows="18" 
            placeholder="Write your article here...&#10;&#10;## Introduction&#10;Detail the attack vector...&#10;&#10;### Defensive Remediation&#10;Implement zero trust policies..." 
            class="w-full p-4 rounded-xl bg-[#030712] border border-cyan-500/30 text-slate-200 font-mono text-sm leading-relaxed focus:outline-none focus:border-[#00E5FF] transition-all"
          ></textarea>
        </div>
      </div>

      <!-- Right: Rank Math Real-Time Live SEO Engine (4 Cols) -->
      <div class="lg:col-span-4 space-y-6 sticky top-24">
        
        <!-- Score Meter Gauge Box -->
        <div class="rounded-2xl bg-[#070E1B] border border-cyan-500/30 p-6 shadow-2xl relative overflow-hidden">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block">Rank Math SEO Score</span>
              <span id="scoreLabel" class="text-xs font-bold text-amber-400">Needs Work</span>
            </div>
            <div id="scoreBox" class="w-16 h-16 rounded-2xl border-2 border-amber-400 bg-amber-400/10 flex items-center justify-center font-mono font-black text-2xl text-amber-400 shadow-[0_0_20px_rgba(251,191,36,0.3)]">
              <span id="scoreVal">0</span>
            </div>
          </div>

          <!-- Focus Keyword -->
          <div class="mt-6 pt-5 border-t border-cyan-500/15">
            <label class="block text-[11px] font-mono text-[#00E5FF] uppercase font-bold mb-1.5 flex items-center gap-1.5">
              <Search class="w-3.5 h-3.5" />
              Focus Keyword
            </label>
            <input 
              id="focusKeyword" 
              type="text" 
              placeholder="e.g. phishing attacks" 
              class="w-full px-3 py-2.5 rounded-xl bg-[#030712] border border-cyan-500/30 text-white text-xs font-mono focus:outline-none focus:border-[#00E5FF]"
            />
          </div>
        </div>

        <!-- SEO Checklist -->
        <div class="rounded-2xl bg-[#070E1B] border border-cyan-500/20 p-6 space-y-4 text-xs font-mono">
          <h2 class="text-sm font-bold text-white font-sans flex items-center gap-2 pb-2 border-b border-cyan-500/15">
            <Sparkles class="w-4 h-4 text-[#00E5FF]" />
            Live Ranking Checklist
          </h2>

          <div class="space-y-3" id="checklist">
            <div id="check-kw-title" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword in Title</span>
            </div>

            <div id="check-kw-desc" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword in Meta Description</span>
            </div>

            <div id="check-kw-url" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword in URL Slug</span>
            </div>

            <div id="check-kw-intro" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword in First 10% of Content</span>
            </div>

            <div id="check-kw-heading" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword in H2 / H3 Subheadings</span>
            </div>

            <div id="check-length" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Length (min 600 words)</span>
            </div>

            <div id="check-density" class="flex items-center gap-2.5 text-slate-400">
              <span class="status-icon"><AlertCircle class="w-4 h-4 text-slate-500" /></span>
              <span>Keyword Density (1% - 2.5%)</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const titleEl = document.getElementById('postTitle') as HTMLInputElement;
  const slugEl = document.getElementById('postSlug') as HTMLInputElement;
  const tagEl = document.getElementById('postTag') as HTMLInputElement;
  const dateEl = document.getElementById('postDate') as HTMLInputElement;
  const descEl = document.getElementById('postDesc') as HTMLTextAreaElement;
  const contentEl = document.getElementById('postContent') as HTMLTextAreaElement;
  const kwEl = document.getElementById('focusKeyword') as HTMLInputElement;

  const scoreVal = document.getElementById('scoreVal');
  const scoreBox = document.getElementById('scoreBox');
  const scoreLabel = document.getElementById('scoreLabel');
  const wordCountLive = document.getElementById('wordCountLive');

  const configToggleBtn = document.getElementById('configToggleBtn');
  const configDrawer = document.getElementById('configDrawer');
  const ghTokenEl = document.getElementById('ghToken') as HTMLInputElement;
  const ghOwnerEl = document.getElementById('ghOwner') as HTMLInputElement;
  const ghRepoEl = document.getElementById('ghRepo') as HTMLInputElement;

  const publishBtn = document.getElementById('publishBtn');
  const publishBtnText = document.getElementById('publishBtnText');

  // Load saved credentials from localStorage
  if (ghTokenEl) ghTokenEl.value = localStorage.getItem('tcd_gh_token') || '';
  if (ghOwnerEl) ghOwnerEl.value = localStorage.getItem('tcd_gh_owner') || '';
  if (ghRepoEl) ghRepoEl.value = localStorage.getItem('tcd_gh_repo') || '';

  configToggleBtn?.addEventListener('click', () => {
    configDrawer?.classList.toggle('hidden');
  });

  [ghTokenEl, ghOwnerEl, ghRepoEl].forEach(input => {
    input?.addEventListener('input', () => {
      localStorage.setItem('tcd_gh_token', ghTokenEl.value.trim());
      localStorage.setItem('tcd_gh_owner', ghOwnerEl.value.trim());
      localStorage.setItem('tcd_gh_repo', ghRepoEl.value.trim());
    });
  });

  // Auto-slug generator
  titleEl.addEventListener('input', () => {
    if (!slugEl.dataset.touched) {
      slugEl.value = titleEl.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');
    }
    audit();
  });

  slugEl.addEventListener('input', () => {
    slugEl.dataset.touched = "true";
    audit();
  });

  [descEl, contentEl, kwEl].forEach(el => el.addEventListener('input', audit));

  function setStatus(id: string, pass: boolean) {
    const row = document.getElementById(id);
    if (!row) return;
    const icon = row.querySelector('.status-icon');
    if (pass) {
      row.className = "flex items-center gap-2.5 text-emerald-400 font-semibold";
      if (icon) icon.innerHTML = `<svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>`;
    } else {
      row.className = "flex items-center gap-2.5 text-rose-400";
      if (icon) icon.innerHTML = `<svg class="w-4 h-4 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
    }
  }

  function audit() {
    const kw = (kwEl.value || '').trim().toLowerCase();
    const title = (titleEl.value || '').toLowerCase();
    const slug = (slugEl.value || '').toLowerCase();
    const desc = (descEl.value || '').toLowerCase();
    const content = (contentEl.value || '').toLowerCase();

    const words = content.trim() ? content.trim().split(/\s+/).length : 0;
    if (wordCountLive) wordCountLive.innerText = `${words} words`;

    let score = 0;
    if (!kw) {
      if (scoreVal) scoreVal.innerText = "0";
      if (scoreLabel) {
        scoreLabel.innerText = "Set Focus Keyword";
        scoreLabel.className = "text-xs font-bold text-slate-500";
      }
      return;
    }

    const inTitle = title.includes(kw);
    setStatus('check-kw-title', inTitle);
    if (inTitle) score += 15;

    const inDesc = desc.includes(kw);
    setStatus('check-kw-desc', inDesc);
    if (inDesc) score += 15;

    const slugClean = kw.replace(/\s+/g, '-');
    const inSlug = slug.includes(slugClean);
    setStatus('check-kw-url', inSlug);
    if (inSlug) score += 15;

    const first10Percent = content.slice(0, Math.max(100, Math.floor(content.length * 0.1)));
    const inIntro = first10Percent.includes(kw);
    setStatus('check-kw-intro', inIntro);
    if (inIntro) score += 15;

    const headingMatches = content.match(/#{2,3}\s+.*(?=\n|$)/g) || [];
    const inHeadings = headingMatches.some(h => h.toLowerCase().includes(kw));
    setStatus('check-kw-heading', inHeadings);
    if (inHeadings) score += 15;

    const lengthPass = words >= 600;
    setStatus('check-length', lengthPass);
    if (lengthPass) score += 15;
    else if (words >= 300) score += 8;

    let count = 0;
    if (words > 0 && kw) {
      const reg = new RegExp(`\\b${kw}\\b`, 'gi');
      count = (content.match(reg) || []).length;
    }
    const density = words > 0 ? (count / words) * 100 : 0;
    const densityPass = density >= 0.8 && density <= 2.5;
    setStatus('check-density', densityPass);
    if (densityPass) score += 10;

    score = Math.min(100, Math.max(0, score));
    if (scoreVal) scoreVal.innerText = `${score}`;

    if (scoreBox && scoreLabel) {
      if (score >= 80) {
        scoreBox.className = "w-16 h-16 rounded-2xl border-2 border-emerald-400 bg-emerald-400/10 flex items-center justify-center font-mono font-black text-2xl text-emerald-400 shadow-[0_0_20px_rgba(52,211,153,0.3)]";
        scoreLabel.innerText = "Rank Math Great (100/100)";
        scoreLabel.className = "text-xs font-bold text-emerald-400";
      } else if (score >= 50) {
        scoreBox.className = "w-16 h-16 rounded-2xl border-2 border-amber-400 bg-amber-400/10 flex items-center justify-center font-mono font-black text-2xl text-amber-400 shadow-[0_0_20px_rgba(251,191,36,0.3)]";
        scoreLabel.innerText = "Good / Needs Work";
        scoreLabel.className = "text-xs font-bold text-amber-400";
      } else {
        scoreBox.className = "w-16 h-16 rounded-2xl border-2 border-rose-500 bg-rose-500/10 flex items-center justify-center font-mono font-black text-2xl text-rose-400 shadow-[0_0_20px_rgba(244,63,94,0.3)]";
        scoreLabel.innerText = "Poor SEO Score";
        scoreLabel.className = "text-xs font-bold text-rose-400";
      }
    }
  }

  // DIRECT PUBLISH CLICK HANDLER
  publishBtn?.addEventListener('click', async () => {
    if (!titleEl.value.trim() || !contentEl.value.trim()) {
      alert('Please provide at least an Article Title and Content before publishing.');
      return;
    }

    if (publishBtnText) publishBtnText.innerText = 'Publishing Post...';

    const payload = {
      title: titleEl.value.trim(),
      slug: slugEl.value.trim(),
      tag: tagEl.value.trim(),
      date: dateEl.value.trim(),
      description: descEl.value.trim(),
      content: contentEl.value.trim(),
      githubToken: ghTokenEl?.value.trim() || undefined,
      repoOwner: ghOwnerEl?.value.trim() || undefined,
      repoName: ghRepoEl?.value.trim() || undefined,
    };

    try {
      const res = await fetch('/api/publish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const json = await res.json();
      if (!res.ok) {
        throw new Error(json.error || 'Failed to publish article');
      }

      alert(`Published successfully! The article is now live at /articles/${json.slug}/`);
      window.location.href = `/articles/${json.slug}/`;
    } catch (err: any) {
      alert(`Publish Error: ${err.message}`);
    } finally {
      if (publishBtnText) publishBtnText.innerText = 'Publish Post Live';
    }
  });
</script>