---
import Layout from '../layouts/Layout.astro';
import { Shield, ArrowRight, Eye, Clock, Calendar } from 'lucide-astro';

const featuredArticles = [
  {
    title: "What is Cybersecurity? A Complete Beginner's Guide",
    slug: "/articles/what-is-cybersecurity-complete-beginners-guide/",
    date: "Sep 8, 2025",
    readTime: "5 min read",
    tag: "Basics"
  },
  {
    title: "Top 10 Cybersecurity Tools You Should Know in 2025",
    slug: "/articles/top-10-cybersecurity-tools-you-should-know-in-2025/",
    date: "Sep 7, 2025",
    readTime: "7 min read",
    tag: "Tools"
  },
  {
    title: "How to Prevent Phishing Attacks (Real Examples + Tips)",
    slug: "/articles/how-to-prevent-phishing-attacks-real-examples-tips/",
    date: "Sep 6, 2025",
    readTime: "6 min read",
    tag: "Threats"
  }
];
---

<Layout title="Cybersecurity Insights for a Safer Digital World">
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Cybersecurity Insights <br />
            for a <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-400">Safer Digital World</span>
          </h1>
          <p class="mt-5 text-sm sm:text-base text-slate-400 leading-relaxed max-w-lg">
            Actionable intelligence, in-depth tutorials, and expert insights to help you stay secure in a connected world.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/articles" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-white text-xs font-bold shadow-lg shadow-sky-500/25 transition-all">
              <span>Explore Articles</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="/tools" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#0B1528] border border-cyan-500/30 hover:border-cyan-400 text-slate-200 text-xs font-bold transition-all hover:bg-cyan-500/10">
              <Eye class="w-4 h-4 text-cyan-400" />
              <span>View Tools</span>
            </a>
          </div>
        </div>

        <!-- Glowing Holographic Cyber Shield Graphic -->
        <div class="relative flex items-center justify-center">
          <div class="relative w-72 h-72 sm:w-80 sm:h-80 flex items-center justify-center">
            <div class="absolute inset-0 rounded-full bg-cyan-500/20 blur-3xl animate-pulse"></div>
            <div class="absolute inset-4 rounded-full border border-cyan-500/30 animate-spin" style="animation-duration: 20s;"></div>
            <div class="absolute inset-10 rounded-full border border-dashed border-sky-400/40 animate-spin" style="animation-duration: 12s; animation-direction: reverse;"></div>

            <div class="relative p-8 rounded-3xl bg-[#091224]/80 border-2 border-cyan-400 shadow-[0_0_50px_rgba(0,229,255,0.35)] backdrop-blur-xl flex flex-col items-center">
              <Shield class="w-20 h-20 text-cyan-400 drop-shadow-[0_0_15px_rgba(0,229,255,0.8)]" />
              <div class="mt-3 text-[11px] font-mono tracking-widest text-cyan-400 font-bold uppercase">SECURED CORE</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Articles Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between border-b border-cyan-500/15 pb-4 mb-8">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-5 rounded-full bg-cyan-400"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-wide">Featured Articles</h2>
      </div>
      <a href="/articles" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
        <span>View All</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((article) => (
        <a href={article.slug} class="group rounded-2xl bg-[#0B1528] border border-cyan-500/20 hover:border-cyan-400/60 p-5 shadow-lg transition-all duration-300 hover:shadow-[0_0_25px_rgba(0,229,255,0.15)] flex flex-col justify-between">
          <div>
            <div class="relative h-40 rounded-xl bg-[#060D1A] border border-cyan-500/20 overflow-hidden flex items-center justify-center mb-4 group-hover:border-cyan-400/40 transition-colors">
              <div class="absolute inset-0 bg-gradient-to-t from-[#0B1528] to-transparent z-10"></div>
              <Shield class="w-12 h-12 text-cyan-500/40 group-hover:text-cyan-400 group-hover:scale-110 transition-all duration-300" />
              <span class="absolute top-3 left-3 z-20 text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                {article.tag}
              </span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">
              {article.title}
            </h3>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="flex items-center gap-1.5">
              <Calendar class="w-3 h-3 text-cyan-400" />
              {article.date}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock class="w-3 h-3 text-cyan-400" />
              {article.readTime}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>