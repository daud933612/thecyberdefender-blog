---
import Layout from '../layouts/Layout.astro';
import { ArrowRight, Eye, Calendar, Clock } from 'lucide-astro';

const featuredArticles = [
  {
    title: "What is Cybersecurity? A Complete Beginner's Guide",
    slug: "/articles/what-is-cybersecurity-complete-beginners-guide/",
    date: "Sep 8, 2025",
    readTime: "5 min read",
    tag: "CYBERSECURITY",
    type: "circuit"
  },
  {
    title: "Top 10 Cybersecurity Tools You Should Know in 2025",
    slug: "/articles/top-10-cybersecurity-tools-you-should-know-in-2025/",
    date: "Sep 7, 2025",
    readTime: "7 min read",
    tag: "TOOLS",
    type: "mesh"
  },
  {
    title: "How to Prevent Phishing Attacks (Real Examples + Tips)",
    slug: "/articles/how-to-prevent-phishing-attacks-real-examples-tips/",
    date: "Sep 6, 2025",
    readTime: "6 min read",
    tag: "CYBERATTACKS",
    type: "hacker"
  }
];
---

<Layout title="Cybersecurity Insights for a Safer Digital World">
  <!-- HERO SECTION -->
  <section class="relative pt-6 pb-16 md:py-16 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-6 z-10">
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-extrabold text-white leading-[1.15] tracking-tight">
            Cybersecurity Insights <br />
            for a <span class="text-[#00E5FF] drop-shadow-[0_0_25px_rgba(0,229,255,0.6)]">Safer Digital World</span>
          </h1>

          <p class="mt-6 text-slate-300 text-sm sm:text-base leading-relaxed max-w-lg font-normal">
            Actionable intelligence, in-depth tutorials, and expert insights to help you stay secure in a connected world.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a 
              href="/articles" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#00D2EE] hover:bg-[#38bdf8] text-slate-950 font-bold text-xs shadow-[0_0_25px_rgba(0,210,238,0.5)] transition-all duration-200"
            >
              <span>Explore Articles</span>
              <ArrowRight class="w-4 h-4 stroke-[2.5]" />
            </a>

            <a 
              href="/tools" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#071329]/80 border border-cyan-500/40 hover:border-cyan-400 text-slate-200 font-bold text-xs transition-all duration-200 hover:bg-cyan-500/10"
            >
              <Eye class="w-4 h-4 text-cyan-400" />
              <span>View Tools</span>
            </a>
          </div>
        </div>

        <!-- Right Visual: The Glowing Cyber Network & Neon Shield Centerpiece -->
        <div class="lg:col-span-6 relative flex items-center justify-center min-h-[380px] sm:min-h-[440px]">
          <!-- Interactive Cyber Network Node Grid Overlay -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-60" viewBox="0 0 600 450" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feMerge>
                  <feMergeNode in="blur"/>
                  <feMergeNode in="SourceGraphic"/>
                </feMerge>
              </filter>
            </defs>
            <!-- Network Connection Lines -->
            <path d="M50 120 L160 80 L280 140 L450 70 L550 160" stroke="#00E5FF" stroke-opacity="0.25" stroke-width="1.2" stroke-dasharray="3 3"/>
            <path d="M80 320 L180 240 L310 360 L480 300 L560 380" stroke="#00E5FF" stroke-opacity="0.25" stroke-width="1.2"/>
            <path d="M160 80 L180 240 L280 140 L310 360" stroke="#00E5FF" stroke-opacity="0.3" stroke-width="1.2"/>
            <path d="M280 140 L480 300 M450 70 L310 360" stroke="#00E5FF" stroke-opacity="0.2" stroke-width="1"/>
            
            <!-- Nodes -->
            <circle cx="50" cy="120" r="3" fill="#00E5FF" opacity="0.6"/>
            <circle cx="160" cy="80" r="4" fill="#00E5FF" filter="url(#glow)"/>
            <circle cx="450" cy="70" r="3.5" fill="#00E5FF" opacity="0.7"/>
            <circle cx="550" cy="160" r="4" fill="#00E5FF" filter="url(#glow)"/>
            <circle cx="80" cy="320" r="3" fill="#00E5FF" opacity="0.6"/>
            <circle cx="180" cy="240" r="4" fill="#00E5FF" filter="url(#glow)"/>
            <circle cx="480" cy="300" r="4" fill="#00E5FF" filter="url(#glow)"/>
            <circle cx="560" cy="380" r="3" fill="#00E5FF" opacity="0.5"/>
          </svg>

          <!-- Core Glowing Concentric Radar Rings -->
          <div class="absolute w-[340px] h-[340px] rounded-full border border-cyan-500/20 animate-pulse"></div>
          <div class="absolute w-[440px] h-[440px] rounded-full border border-cyan-500/10 hidden sm:block"></div>
          <div class="absolute w-[240px] h-[240px] rounded-full bg-cyan-500/20 blur-[70px]"></div>

          <!-- The Realistic Neon Shield Badge -->
          <div class="relative z-10 flex flex-col items-center justify-center">
            <svg class="w-64 h-72 sm:w-72 sm:h-80 drop-shadow-[0_0_35px_rgba(0,229,255,0.7)]" viewBox="0 0 200 240" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Outer Glowing Shield Edge -->
              <path d="M100 8 L178 38 V110 C178 168 144 208 100 226 C56 208 22 168 22 110 V38 L100 8 Z" 
                    fill="#040C1A" 
                    stroke="#00E5FF" 
                    stroke-width="3.5"
                    stroke-linejoin="round"/>
              
              <!-- Inner Neon Border -->
              <path d="M100 24 L162 48 V108 C162 154 135 188 100 204 C65 188 38 154 38 108 V48 L100 24 Z" 
                    stroke="#00E5FF" 
                    stroke-opacity="0.5" 
                    stroke-width="1.5"/>

              <!-- Centered Padlock Graphic inside Shield -->
              <!-- Padlock Shackle -->
              <path d="M84 102 V86 C84 77.16 91.16 70 100 70 C108.84 70 116 77.16 116 86 V102" 
                    stroke="#00E5FF" 
                    stroke-width="4.5" 
                    stroke-linecap="round"
                    fill="none"
                    filter="url(#glow)"/>
              
              <!-- Padlock Body -->
              <rect x="74" y="100" width="52" height="42" rx="7" fill="#00E5FF" filter="url(#glow)"/>
              
              <!-- Keyhole -->
              <circle cx="100" cy="116" r="3.5" fill="#040C1A"/>
              <path d="M100 118 V128" stroke="#040C1A" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FEATURED ARTICLES SECTION -->
  <section class="max-w-[1400px] mx-auto px-6 pt-4 pb-20">
    <div class="flex items-center justify-between border-b border-cyan-500/15 pb-4 mb-8">
      <div class="flex items-center gap-2.5">
        <span class="w-1.5 h-5 rounded-full bg-[#00E5FF] shadow-[0_0_12px_#00E5FF]"></span>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-wide">Featured Articles</h2>
      </div>
      <a href="/articles" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
        <span>View All</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- 3-Column Illustrated Cyber Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((article) => (
        <a 
          href={article.slug} 
          class="group rounded-2xl bg-[#040C1B] border border-cyan-500/25 hover:border-cyan-400 p-4 transition-all duration-300 hover:shadow-[0_0_30px_rgba(0,229,255,0.25)] flex flex-col justify-between"
        >
          <div>
            <!-- High-Tech Illustrated Thumbnail Container -->
            <div class="relative h-44 rounded-xl bg-[#020712] border border-cyan-500/30 overflow-hidden flex items-center justify-center mb-4 group-hover:border-cyan-400 transition-all">
              
              <!-- Card 1 Artwork: Circuit Padlock -->
              {article.type === 'circuit' && (
                <div class="relative w-full h-full flex items-center justify-center">
                  <div class="absolute inset-0 bg-[radial-gradient(#00e5ff_1px,transparent_1px)] [background-size:14px_14px] opacity-25"></div>
                  <svg class="w-24 h-24 text-cyan-400 drop-shadow-[0_0_18px_rgba(0,229,255,0.8)]" viewBox="0 0 100 100" fill="none">
                    <circle cx="50" cy="50" r="42" stroke="#00E5FF" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>
                    <circle cx="50" cy="50" r="32" stroke="#00E5FF" stroke-width="2"/>
                    <rect x="40" y="46" width="20" height="18" rx="3" fill="#00E5FF"/>
                    <path d="M44 46 V40 C44 36.6 46.7 34 50 34 C53.3 34 56 36.6 56 40 V46" stroke="#00E5FF" stroke-width="3" fill="none"/>
                  </svg>
                </div>
              )}

              <!-- Card 2 Artwork: Neural Shield Mesh -->
              {article.type === 'mesh' && (
                <div class="relative w-full h-full flex items-center justify-center">
                  <div class="absolute inset-0 bg-gradient-to-tr from-cyan-950/40 to-blue-900/20"></div>
                  <svg class="w-24 h-24 text-cyan-400 drop-shadow-[0_0_18px_rgba(0,229,255,0.8)]" viewBox="0 0 100 100" fill="none">
                    <polygon points="50,15 80,30 80,65 50,85 20,65 20,30" stroke="#00E5FF" stroke-width="2" fill="#040C1A"/>
                    <polygon points="50,28 70,38 70,60 50,72 30,60 30,38" stroke="#00E5FF" stroke-width="1.2" opacity="0.6"/>
                    <circle cx="50" cy="50" r="5" fill="#00E5FF"/>
                  </svg>
                </div>
              )}

              <!-- Card 3 Artwork: Cyber Hooded Hacker Silhouette -->
              {article.type === 'hacker' && (
                <div class="relative w-full h-full flex items-center justify-center">
                  <div class="absolute inset-0 opacity-20 font-mono text-[9px] text-cyan-400 p-2 overflow-hidden select-none">
                    01001000 01000001 01000011 01001011<br/>
                    10110010 00101101 11010010 01101001
                  </div>
                  <svg class="w-24 h-24 text-cyan-400 drop-shadow-[0_0_18px_rgba(0,229,255,0.8)]" viewBox="0 0 100 100" fill="none">
                    <!-- Hooded Figure Silhouette with glowing cyan rim -->
                    <path d="M50 20 C35 20 28 35 26 50 C26 70 20 85 10 90 H90 C80 85 74 70 74 50 C72 35 65 20 50 20 Z" fill="#061224" stroke="#00E5FF" stroke-width="1.8"/>
                    <!-- Dark face void -->
                    <ellipse cx="50" cy="46" rx="14" ry="18" fill="#020712"/>
                  </svg>
                </div>
              )}

              <!-- Pill Tag (Basics / Tools / Threats) -->
              <span class="absolute top-3 left-3 text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 uppercase">
                {article.tag}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">
              {article.title}
            </h3>
          </div>

          <!-- Card Metadata Footer -->
          <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span class="flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5 text-cyan-400" />
              {article.date}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock class="w-3.5 h-3.5 text-cyan-400" />
              {article.readTime}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>