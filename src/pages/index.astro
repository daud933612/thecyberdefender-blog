---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1100px;
				margin: 0 auto;
				padding: 3rem 1.5rem 6rem;
			}
			.hero {
				padding: 3rem 0;
				border-bottom: 1px solid var(--border);
				margin-bottom: 3.5rem;
			}
			.tag {
				display: inline-block;
				background: rgba(0, 229, 255, 0.1);
				border: 1px solid rgba(0, 229, 255, 0.3);
				color: var(--accent);
				font-size: 0.8rem;
				font-weight: 700;
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				letter-spacing: 0.5px;
				margin-bottom: 1.5rem;
			}
			h1 {
				font-size: 3.25rem;
				font-weight: 800;
				line-height: 1.15;
				margin: 0 0 1.25rem;
				color: #ffffff;
				letter-spacing: -1px;
			}
			.lead {
				font-size: 1.25rem;
				line-height: 1.6;
				color: var(--text-muted);
				max-width: 700px;
				margin: 0 0 2rem;
			}
			.hero-cta {
				display: flex;
				gap: 1rem;
			}
			.btn-primary {
				background: #0284c7;
				color: #ffffff;
				font-weight: 600;
				padding: 0.75rem 1.75rem;
				border-radius: 6px;
				transition: background 0.15s ease;
			}
			.btn-primary:hover {
				background: #0369a1;
				color: #ffffff;
			}
			.btn-secondary {
				border: 1px solid var(--border);
				color: var(--text-main);
				font-weight: 600;
				padding: 0.75rem 1.75rem;
				border-radius: 6px;
				background: var(--bg-card);
				transition: border-color 0.15s ease;
			}
			.btn-secondary:hover {
				border-color: var(--accent);
			}
			.section-title {
				font-size: 1.75rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1.5rem;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.5rem;
				margin-bottom: 4rem;
			}
			.post-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 1.5rem;
				transition: transform 0.2s ease, border-color 0.2s ease;
				display: flex;
				flex-direction: column;
			}
			.post-card:hover {
				transform: translateY(-3px);
				border-color: var(--accent);
			}
			.post-card h3 {
				font-size: 1.25rem;
				margin: 0.5rem 0;
				color: #ffffff;
			}
			.post-card p {
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.5;
				flex-grow: 1;
			}
			.post-date {
				font-size: 0.8rem;
				color: #64748b;
				margin-top: 1rem;
			}
			.sponsor-banner {
				background: linear-gradient(180deg, #0f172a 0%, #080c14 100%);
				border: 1px solid #1e293b;
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				padding: 2.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.sponsor-banner h2 {
				font-size: 1.5rem;
				margin: 0 0 0.5rem;
				color: #ffffff;
			}
			.sponsor-banner p {
				color: var(--text-muted);
				margin: 0;
				max-width: 600px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="tag">DEFENSIVE OPERATIONS & THREAT INTEL</span>
				<h1>The Cyber Defender</h1>
				<p class="lead">
					Actionable intelligence, endpoint detection, zero-trust architectures, and offensive security countermeasures for modern defenders.
				</p>
				<div class="hero-cta">
					<a href="/blog" class="btn-primary">Explore Research</a>
					<a href="/write-for-us" class="btn-secondary">Submit Guest Post</a>
				</div>
			</section>

			<h2 class="section-title">Latest Analysis</h2>
			<div class="posts-grid">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="post-card">
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
						<span class="post-date">
							{post.data.pubDate.toLocaleDateString('en-us', {
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
						</span>
					</a>
				))}
			</div>

			<section class="sponsor-banner">
				<div>
					<h2>Contribute Research & Sponsored Content</h2>
					<p>Accepting high-value publications from cybersecurity experts, vendors, and security researchers.</p>
				</div>
				<a href="/write-for-us" class="btn-primary">Guidelines & Pricing</a>
			</section>
		</main>
		<Footer />
	</body>
</html>