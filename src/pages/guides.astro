---
import Layout from '../layouts/Layout.astro';
import { BookOpen, Clock, ArrowRight } from 'lucide-astro';

const guideFilters = [
  "All Guides",
  "Beginner Guides",
  "Intermediate",
  "Advanced",
  "Hands-on Labs",
  "Career & Learning"
];

const guidesList = [
  {
    title: "Beginner's Guide to Cybersecurity",
    slug: "/guides/beginners-guide-to-cybersecurity/",
    readTime: "10 min read",
    level: "Beginner"
  },
  {
    title: "How to Set Up a VPN (With Examples)",
    slug: "/guides/how-to-set-up-a-vpn-with-examples/",
    readTime: "8 min read",
    level: "Beginner"
  },
  {
    title: "Linux Security Basics",
    slug: "/guides/linux-security-basics/",
    readTime: "12 min read",
    level: "Intermediate"
  },
  {
    title: "Web Application Security Fundamentals",
    slug: "/guides/web-application-security-fundamentals/",
    readTime: "15 min read",
    level: "Intermediate"
  },
  {
    title: "Ethical Hacking Lab Setup (Kali Linux)",
    slug: "/guides/ethical-hacking-lab-setup-kali-linux/",
    readTime: "14 min read",
    level: "Hands-on Labs"
  },
  {
    title: "Digital Privacy Guide",
    slug: "/guides/digital-privacy-guide/",
    readTime: "9 min read",
    level: "Beginner"
  }
];
---

<Layout title="Cybersecurity Guides | Step-by-Step Security Roadmaps">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Cybersecurity Guides</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Step-by-step guides to help you learn, practice, and build your skills.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      <aside class="bg-[#0B1528] border border-cyan-500/20 rounded-2xl p-4 sticky top-24">
        <h2 class="text-xs font-mono font-bold tracking-wider text-cyan-400 uppercase mb-3 px-2">
          Track Levels
        </h2>
        <nav class="space-y-1">
          {guideFilters.map((filter, idx) => (
            <button 
              class={`w-full text-left px-3 py-2 rounded-xl text-xs font-medium transition-all ${
                idx === 0 
                  ? 'bg-cyan-500/15 border border-cyan-500/40 text-cyan-300 font-semibold' 
                  : 'text-slate-300 hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              {filter}
            </button>
          ))}
        </nav>
      </aside>

      <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {guidesList.map((g) => (
          <a href={g.slug} class="group rounded-2xl bg-[#0B1528] border border-cyan-500/20 hover:border-cyan-400/60 p-4 shadow-lg flex flex-col justify-between transition-all duration-300 hover:shadow-[0_0_20px_rgba(0,229,255,0.12)]">
            <div>
              <div class="relative h-32 rounded-xl bg-[#060D1A] border border-cyan-500/20 overflow-hidden flex items-center justify-center mb-3">
                <BookOpen class="w-10 h-10 text-cyan-500/40 group-hover:text-cyan-400 group-hover:scale-110 transition-all duration-300" />
                <span class="absolute top-2 left-2 text-[9px] font-mono px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30">
                  {g.level}
                </span>
              </div>
              <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">
                {g.title}
              </h3>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-[10px] font-mono text-slate-400">
              <span class="flex items-center gap-1 text-cyan-400">
                <Clock class="w-3 h-3" />
                {g.readTime}
              </span>
              <span class="text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Read Guide <ArrowRight class="w-3 h-3" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>