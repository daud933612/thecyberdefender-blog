---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Cybersecurity Research & Articles | ${SITE_TITLE}`} description="Browse threat intelligence briefs, offensive analysis, and defensive security engineering guides." />
		<style>
			main {
				max-width: 1000px;
				margin: 3rem auto 6rem;
				padding: 0 1.5rem;
			}
			.page-header {
				margin-bottom: 3rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 1.5rem;
			}
			h1 {
				font-size: 2.5rem;
				font-weight: 800;
				margin: 0 0 0.5rem;
				color: #ffffff;
			}
			.subtext {
				color: var(--text-muted);
				margin: 0;
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.article-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 2rem;
				text-decoration: none;
				transition: transform 0.2s, border-color 0.2s;
				display: block;
			}
			.article-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
			}
			.article-card h2 {
				color: #ffffff;
				font-size: 1.5rem;
				margin: 0 0 0.75rem;
			}
			.article-card p {
				color: var(--text-muted);
				margin: 0 0 1rem;
				line-height: 1.6;
			}
			.date {
				font-size: 0.85rem;
				color: #64748b;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Security Articles & Research</h1>
				<p class="subtext">In-depth technical guides, threat reports, and architecture blueprints.</p>
			</div>
			<div class="post-list">
				{posts.map((post) => (
					<a href={`/blog/${post.id}/`} class="article-card">
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
						<span class="date">
							{post.data.pubDate.toLocaleDateString('en-us', {
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
						</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>